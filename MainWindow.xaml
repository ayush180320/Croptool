<Window x:Class="VideoCropper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pro Video Cropper" Height="650" Width="1100"
        Background="#2b2b2b" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" /> 
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#333333" BorderBrush="#111" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="1. INPUT FILE" Foreground="#ff8c00" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                <Button Content="Browse..." Background="#444" Foreground="White" BorderThickness="0" Height="30" Click="BtnBrowse_Click"/>
                <TextBlock x:Name="TxtFilePath" Text="No file selected" Foreground="#aaa" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,20"/>

                <TextBlock Text="2. CHOOSE FUNCTION" Foreground="#ff8c00" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox Background="#444" Foreground="Black" Height="30" Margin="0,0,0,20">
                    <ComboBoxItem Content="Apple ProRes 422 HQ" IsSelected="True"/>
                </ComboBox>

                <TextBlock Text="3. IMAGE CROPPING" Foreground="#ff8c00" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                <Button Content="Auto-Detect Black Bars" Background="#555" Foreground="White" BorderThickness="0" Height="30" Click="BtnAutoCrop_Click" Margin="0,0,0,15"/>
                
                <Grid Margin="0,0,0,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Top:" Foreground="White" Width="35"/>
                        <TextBox x:Name="TxtTop" Text="0" Background="#222" Foreground="White" BorderThickness="0" Width="60" Height="22" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bottom:" Foreground="White" Width="45"/>
                        <TextBox x:Name="TxtBottom" Text="0" Background="#222" Foreground="White" BorderThickness="0" Width="60" Height="22" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Left:" Foreground="White" Width="35"/>
                        <TextBox x:Name="TxtLeft" Text="0" Background="#222" Foreground="White" BorderThickness="0" Width="60" Height="22" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Right:" Foreground="White" Width="45"/>
                        <TextBox x:Name="TxtRight" Text="0" Background="#222" Foreground="White" BorderThickness="0" Width="60" Height="22" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="4. START" Foreground="#ff8c00" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                <Button Content="Start function" Background="#ff8c00" Foreground="Black" FontWeight="Bold" BorderThickness="0" Height="45" Click="BtnExport_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#1a1a1a" Padding="20">
            <Grid Background="Black">
                <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" Stretch="Uniform"/>
                
                <Canvas x:Name="CropCanvas" Background="Transparent" 
                        MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp" SizeChanged="Canvas_SizeChanged">
                    
                    <Rectangle x:Name="LineTop" Height="2" Width="2000" Fill="#00ffff" Cursor="SizeNS" MouseDown="Line_MouseDown" Canvas.Top="0"/>
                    <Rectangle x:Name="LineBottom" Height="2" Width="2000" Fill="#00ffff" Cursor="SizeNS" MouseDown="Line_MouseDown" Canvas.Top="500"/>
                    <Rectangle x:Name="LineLeft" Width="2" Height="2000" Fill="#00ffff" Cursor="SizeWE" MouseDown="Line_MouseDown" Canvas.Left="0"/>
                    <Rectangle x:Name="LineRight" Width="2" Height="2000" Fill="#00ffff" Cursor="SizeWE" MouseDown="Line_MouseDown" Canvas.Left="700"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
